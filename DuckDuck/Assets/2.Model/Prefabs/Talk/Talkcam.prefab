  typingSpeed: 0.05
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
        m_TargetAssemblyTypeName: Malmanager, Assembly-CSharp
        m_MethodName: 
        m_Mode: 1
