          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  playOnStart: 1
  startDialogueList:
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uC77C\uC5B4\uB098..!"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: 
    sentence: ...?!
    isLeftSpeaker: 0
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uB4DC\uB514\uC5B4 \uC77C\uC5B4\uB0AC\uAD6C\uB098!!"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: 
    sentence: "(\uB108\uB294 \uB204\uAD6C\uC57C!!! \uC5EC\uAE34 \uC5B4\uB514\uACE0!!!!)"
    isLeftSpeaker: 0
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uC557 \uB09C\uB3D9 \uD53C\uC6B0\uC9C0 \uB9C8..!!\n\uC18C\uB9AC\uB97C
      \uB4E3\uACE0 \uADF8 \uB140\uC11D\uB4E4\uC774 \uC628\uB2E8 \uB9D0\uC774\uC57C!!"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uB0B4 \uC774\uB984\uC740 \uC2A4\uD0A4\uC870\uC57C...\r\n\uBC14\uAE65\uC5D0\uC11C\uB294
      \uC9C0\uAE08 \uC815\uCCB4\uBD88\uBA85\uC758 \uBC14\uC774\uB7EC\uC2A4\uB85C
      \uC778\uD574\r\n\uBAA8\uB4E0 \uC0AC\uB78C\uB4E4\uC774 \uAC10\uC5FC\uB410\uC5B4...\r\n"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uB108\uB294 \uC720\uC77C\uD55C \uC0DD\uC874\uC790\uC9C0\uB9CC...\n\uADF8
      \uB140\uC11D\uB4E4\uC774 \uB110 \uC5EC\uAE30\uC5D0 \uAC10\uAE08\uD574\uB1A8\uC5B4..."
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: 
    sentence: "(\uC548\uB3FC, \uC5EC\uAE30\uC11C \uB098\uAC00\uC57C\uD574.....)\r\n"
    isLeftSpeaker: 0
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uAC10\uC5FC\uC790\uB4E4\uC774 \uB110 \uC8FD\uC774\uB824\uB4E4\uAC70\uB77C\uACE0!\r\n"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: 
    sentence: "(\uAC00\uC871\uB4E4\uC774 \uAC71\uC815\uB3FC, \uB2F9\uC7A5 \uC9D1\uC73C\uB85C
      \uAC00\uC57C\uACA0\uC5B4) \r\n"
    isLeftSpeaker: 0
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uC5EC\uAE38 \uD0C8\uCD9C\uD558\uB294\uAC74 \uC27D\uC9C0 \uC54A\uC744\uD150\uB370...
      \r\n"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: '!!!!

'
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uC774\uB7F0 \uC544\uAE4C \uC18C\uB9AC\uB97C \uB4E3\uACE0 \uAC10\uC5FC\uC790\uAC00
      \uC654\uC5B4!!!\r \n"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uB0B4\uAC00 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uAC8C \uB3C4\uC640\uC904\uAC8C!!!\n"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uAC00\uC790!"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
