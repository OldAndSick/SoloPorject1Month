  myDialogue:
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uD734 \uACA8\uC6B0 \uB098\uB124...\uC9C4\uC9DC \uC774\uC0C1\uD55C\n\uB140\uC11D\uB4E4\uC774
      \uC5C4\uCCAD \uB3CC\uC544\uB2E4\uB2C8\uB124"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uB098"
    sentence: "\uADF8\uB7EC\uAC8C \uC774\uB7F0 \uAC70\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uB294\uB370..."
    isLeftSpeaker: 0
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uC5BC\uB978 \uC9D1\uC73C\uB85C \uAC00\uBCF4\uC790...!\n\uC9D1\uC740
      \uC5B4\uB514\uC57C?"
    isLeftSpeaker: 1
    characterSprite: {fileID: 0}
  - name: "\uB098"
    sentence: "\uC800\uAE30 \uBD84\uD64D \uD398\uC778\uD2B8\uAC00 \uCE60\uD574\uC838\uC788\uB294\n\uACE8\uBAA9\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uC57C \uD574!"
    isLeftSpeaker: 0
    characterSprite: {fileID: 0}
  - name: "\uC2A4\uD0A4\uC870"
    sentence: "\uC54C\uACA0\uC5B4 \uC5BC\uB978 \uCD9C\uBC1C\uD558\uC790!"
