      value: Title2
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: introTexts.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: .....
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C, \uC2DC\uCCAD\uC790 \uC5EC\uB7EC\uBD84."
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: "\uB3C4\uC2EC \uD55C\uBCF5\uD310\uC5D0\uC11C "
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: "\uB054\uCC0D\uD55C \uCD1D\uAE30 \uB09C\uC0AC\uADF9\uC744 \uBC8C\uC774\uACE0
        \uB3C4\uC8FC\uD588\uB358"
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: "\uD53C\uC758\uC790\uAC00 \uACBD\uCC30\uC5D0 \uAC80\uAC70 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: "\uC774\uBC88 \uC0AC\uAC74\uC73C\uB85C \uD55C \uC77C\uAC00\uC871\uC774
        \uBAB0\uC0B4 \uB2F9\uD558\uB294 \uBE44\uADF9\uC774 \uBC1C\uC0DD\uD588\uB294\uB370\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: "\uD53C\uD574\uC790\uB4E4\uC740 \uBAA8\uB450 \uD53C\uC758\uC790\uC640
        \uD608\uC5F0\uAD00\uACC4\uC778 \uAC83\uC73C\uB85C \uD655\uC778\uB418\uC5B4
        \uC548\uD0C0\uAE4C\uC6C0\uC744 \uB354 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[7]'
      value: "\uD3C9\uC18C \uC870\uD604\uBCD1\uC744 \uC553\uACE0 \uC788\uC5C8\uB358
        \uAC83\uC73C\uB85C \uD30C\uC545\uB418\uBA70,"
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[8]'
      value: "\uC815\uC2E0\uBCD1\uC6D0\uC5D0 \uC785\uC6D0\uD574 \uCE58\uB8CC\uB97C
        \uBC1B\uB358 \uC911, \uC2DC\uC124\uC744 \uBB34\uB2E8 \uD0C8\uCD9C\uD574 \uC774
        \uAC19\uC740 \uBC94\uD589\uC744 \uC800\uC9C0\uB978 \uAC83\uC73C\uB85C \uB4DC\uB7EC\uB0AC\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[9]'
      value: "\uC2DC\uBBFC\uB4E4\uC758 \uBD88\uC548\uC774 \uAC00\uC911\uB418\uACE0
        \uC788\uB294 \uAC00\uC6B4\uB370..."
      objectReference: {fileID: 0}
    - target: {fileID: 2561845964969463249, guid: 0aff742b7c17b87448958fd62a0e82d5, type: 3}
      propertyPath: 'introTexts.Array.data[10]'
      value: "\uC815\uBD80\uC758 \uB300\uC751\uCC45.....\uB9C8\uB828.......\uC774\uC5B4\uC9C0\uB294..\uC18C\uC2DD..."
